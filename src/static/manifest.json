{
  "name": "Weather Extension",
  "description": "Weather information for your favorite cities",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Weather Extension",
    "default_icon": "icon.png"
  },
  "permissions": ["storage", "alarms", "contextMenus", "tabs"],
  "host_permissions": ["https://api.openweathermap.org/*"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"]
    }
  ]
}
